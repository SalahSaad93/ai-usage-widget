<Project Sdk="Microsoft.NET.Sdk">

  <!-- For IDEs and `dotnet build` (needs the .NET SDK). build.ps1 stays the release build:
       it needs nothing but Windows. Both compile the same sources as C# 5. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>AiUsageWidget</RootNamespace>
    <AssemblyName>AiUsageWidget</AssemblyName>
    <Version>0.0.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\sdk\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="AiUsageWidget.app.ico" />
    <InternalsVisibleTo Include="AiUsageWidget.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
