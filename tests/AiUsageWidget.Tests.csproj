<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless checks and the screenshot renderer, as a separate exe that references
       the widget. Options are described at the top of TestProgram.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>AiUsageWidget</RootNamespace>
    <AssemblyName>AiUsageWidget.Tests</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\sdk\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <ProjectReference Include="..\AiUsageWidget.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
